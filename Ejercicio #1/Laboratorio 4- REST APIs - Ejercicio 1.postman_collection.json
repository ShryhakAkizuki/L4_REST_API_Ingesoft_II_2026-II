            "exec": [
              "pm.test(\"El código es 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Devuelve una lista de publicaciones\", () => {\r",
              "    const publicaciones = pm.response.json();\r",
              "\r",
              "    pm.expect(publicaciones).to.be.an(\"array\");\r",
              "    pm.expect(publicaciones).to.have.lengthOf(10);\r",
              "});\r",
              "\r",
              "pm.test(\"Las publicaciones pertenecen al usuario 1\", () => {\r",
              "    const publicaciones = pm.response.json();\r",
              "\r",
              "    publicaciones.forEach(post => {\r",
              "        pm.expect(post.userId).to.eql(1);\r",
              "    });\r",
              "});"
